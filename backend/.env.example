# ===========================================================================
# FrostGuard AC Services — Environment Configurations
# ===========================================================================

# 🤖 Gemini API Key (Required for LLM and RAG embeddings)
# Get a free key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 🗄️ Supabase PostgreSQL Connection String (Optional locally, Required for production Vercel)
# Format: postgresql://postgres.[project-id]:[password]@[host]:5432/postgres?sslmode=require
# If left blank or commented out locally, the system falls back to a local SQLite database.
DATABASE_URL=

# 🌐 Allowed Origins (CORS configuration for FastAPI)
# For local dev, include localhost. For production, include your Vercel frontend domain.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000